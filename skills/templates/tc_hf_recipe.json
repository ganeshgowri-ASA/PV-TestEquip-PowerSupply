{
  "$schema": "pv-test-recipe-v1",
  "recipe_type": "tc_hf",
  "name": "Thermal Cycling / Humidity Freeze Test Recipe",
  "standard": "IEC 61215:2021 (10.11 / 10.12)",
  "company": "Antaryami Solar Analytics",
  "version": "1.0.0",

  "thermal_cycling": {
    "designation": "TC200",
    "total_cycles": 200,
    "temperature": {
      "t_min": -40,
      "t_max": 85,
      "unit": "°C",
      "ramp_rate_max": 100,
      "ramp_rate_unit": "°C/hr",
      "dwell_time_min": 10,
      "dwell_time_unit": "minutes",
      "dwell_tolerance": 2
    },
    "cycle_profile": {
      "description": "Linear ramp from T_min to T_max, dwell, ramp back, dwell",
      "phases": [
        {
          "phase": "cold_dwell",
          "target_temp": -40,
          "duration_min": 10,
          "tolerance": 2
        },
        {
          "phase": "ramp_up",
          "from_temp": -40,
          "to_temp": 85,
          "max_duration_min": 75,
          "ramp_rate": 100
        },
        {
          "phase": "hot_dwell",
          "target_temp": 85,
          "duration_min": 10,
          "tolerance": 2
        },
        {
          "phase": "ramp_down",
          "from_temp": 85,
          "to_temp": -40,
          "max_duration_min": 75,
          "ramp_rate": 100
        }
      ],
      "cycle_duration_max_min": 360,
      "cycle_duration_max_note": "6 hours max per cycle per IEC 61215"
    },
    "current_injection": {
      "enabled": true,
      "method": "ABSI",
      "standard_ref": "IEC 61215:2021 Annex A",
      "current_value_A": 27.0,
      "current_note": "Equal to Isc of module under test",
      "injection_window": {
        "start_condition": "module_temp >= 25°C during ramp_up",
        "stop_condition": "module_temp < 25°C during ramp_down"
      },
      "polarity": "forward_bias"
    }
  },

  "humidity_freeze": {
    "designation": "HF10",
    "total_cycles": 10,
    "temperature": {
      "t_min": -40,
      "t_max": 85,
      "unit": "°C"
    },
    "humidity": {
      "rh_setpoint": 85,
      "rh_unit": "%",
      "rh_tolerance": 5,
      "humidity_active_range": {
        "temp_min": 25,
        "temp_max": 85,
        "note": "Humidity control only active above 25°C"
      }
    },
    "cycle_profile": {
      "phases": [
        {
          "phase": "hot_humid_dwell",
          "target_temp": 85,
          "target_rh": 85,
          "duration_hr": 20,
          "tolerance_temp": 2,
          "tolerance_rh": 5
        },
        {
          "phase": "ramp_down_to_freeze",
          "from_temp": 85,
          "to_temp": -40,
          "humidity_off_below": 25,
          "max_duration_hr": 4
        },
        {
          "phase": "freeze_dwell",
          "target_temp": -40,
          "duration_min": 30,
          "tolerance": 2
        },
        {
          "phase": "ramp_up",
          "from_temp": -40,
          "to_temp": 85,
          "max_duration_hr": 4,
          "humidity_on_above": 25
        }
      ]
    },
    "current_injection": {
      "enabled": false,
      "note": "No current injection during HF per IEC 61215"
    }
  },

  "power_supply_requirements": {
    "voltage_range_V": [0, 72],
    "current_range_A": [0, 33],
    "power_per_channel_W": 2400,
    "channels": 10,
    "total_power_kW": 24,
    "bidirectional": true,
    "regenerative": true,
    "regenerative_efficiency_min": 0.90,
    "voltage_sensing": "4-wire Kelvin",
    "regulation_accuracy": "±0.5%",
    "communication": ["Modbus RTU", "Modbus TCP"],
    "safety": {
      "ovp_threshold": "Voc × 1.3",
      "ocp_threshold": "Isc × 1.2",
      "otp_threshold_C": 85,
      "emergency_stop": true,
      "ground_fault_mA": 30
    }
  },

  "measurement_requirements": {
    "voltage_accuracy": "±0.1%",
    "current_accuracy": "±0.2%",
    "temperature_sensors": ["module_surface", "ambient", "chamber"],
    "sampling_rate_hz": 1,
    "data_format": ["csv", "json"],
    "log_fields": [
      "timestamp",
      "channel_id",
      "voltage_V",
      "current_A",
      "power_W",
      "module_temp_C",
      "chamber_temp_C",
      "cycle_number",
      "phase"
    ]
  },

  "pass_fail_criteria": {
    "max_pmax_degradation_percent": 5,
    "max_isc_degradation_percent": 5,
    "visual_inspection": "No major defects per IEC 61215 Table 2",
    "insulation_test_post": "1000V + 2×Voc, leakage < 50µA/m²",
    "wet_leakage_post": "500V, resistance > 400 MΩ·m²"
  }
}
